extends base.pug

block vars
  - $summaryData = is_object($summary ?? null) ? (array) $summary : ($summary ?? []);
  - $teams = array_filter($summaryData, function ($key) { return str_starts_with($key, 'team'); }, ARRAY_FILTER_USE_KEY);
  - $excluded = (array) ($summaryData['excluded'] ?? []);
  - $totalLostISK = 0; $totalSize = 0; $totalShips = 0; $totalPoints = 0;
  - foreach ($teams as $team) { $totals = (array) (((array) $team)['totals'] ?? []); $totalLostISK += $totals['total_price'] ?? 0; $totalSize += $totals['pilotCount'] ?? 0; $totalShips += $totals['totalShips'] ?? 0; $totalPoints += $totals['total_points'] ?? 0; }
  - $nextSide = 'C'; while (isset($teams['team' . $nextSide])) { ++$nextSide; }
  - $reportUrl = '/related/' . ($solarSystemID ?? 0) . '/' . ($relatedTime ?? 0) . '/o/' . rawurlencode($options ?? '{}') . '/';
  - $priceTitle = function ($prices) { $prices = is_object($prices ?? null) ? (array) $prices : ($prices ?? []); return '$' . number_format((float) ($prices['usd'] ?? 0), 2, '.', ',') . ' / ' . number_format((float) ($prices['eur'] ?? 0), 2, '.', ',') . ' euro / GBP ' . number_format((float) ($prices['gbp'] ?? 0), 2, '.', ','); };
  - $reportSystemNames = implode(', ', (array) ($selectedSystems ?? [$systemName ?? '']));
  - $timeOptions = json_decode($options ?? '{}', true) ?? [];
  - $reportTime = ($startTime ?? '') . ' – ' . ($endTime ?? '') . ' UTC';
  - $pageTitle = 'Related Kills | ' . $reportSystemNames . ' | ' . $reportTime;

block title
  include components/title.pug

block style
  style.
    body:has(#related-report.related-report-wide) .ad-xl-block {
      display: none !important;
    }

block content
  #related-report.related-report-page(class=(count($teams) > 2 ? 'related-report-wide' : ''))
    h2.related-report-title
      small Battle Report: 
      = $reportSystemNames . (count((array) ($selectedSystems ?? [])) <= 1 ? ' (' . ($regionName ?? '') . ')' : '') . ' / ' . $reportTime
    .related-report-links
      a(href=('https://br.evetools.org/related/' . ($solarSystemID ?? 0) . '/' . ($unixtime ?? 0) . '/') target="_blank" rel="noopener noreferrer")
        i br.evetools.org
      a(href=('https://warbeacon.net/br/related/' . ($solarSystemID ?? 0) . '/' . ($relatedTime ?? 0) . '/') target="_blank" rel="noopener noreferrer")
        i warbeacon.net
      a(target="_blank" href="https://riftforeve.online/" rel="noopener noreferrer")
        img(src="/img/nohus/Icon-256.png" style="height: 24px; width: 24px;" alt="RIFT" loading="lazy" decoding="async")
        |  RIFT
      a(href=('https://killmail.app/related/' . ($solarSystemID ?? 0) . '/' . ($relatedTime ?? 0) . '/') target="_blank" rel="noopener noreferrer")
        img(src="/img/killmail-app/logo.png" style="margin-right: 6px; height: 20px; width: 20px;" alt="killmail.app" loading="lazy" decoding="async")
        | killmail.app
    .mb-3
      .d-flex.flex-wrap.align-items-center.gap-2.mb-2
        strong= 'Systems (' . count((array) ($selectedSystems ?? [])) . '/10):'
        each $name, $id in ($selectedSystems ?? [])
          if (count((array) ($selectedSystems ?? [])) == 1)
            span.badge.text-bg-secondary= $name
          else
            a.badge.text-bg-secondary.text-decoration-none(rel="nofollow" href=($reportUrl . '?removeSystem=' . $id) title=('Remove ' . $name))= $name . ' ×'
      .row.g-2.align-items-center
        if (count((array) ($selectedSystems ?? [])) < 10)
          form.col-12.col-lg-auto.d-flex.flex-wrap.align-items-center.gap-2(method="get" action=$reportUrl data-bs-theme="dark")
            label.form-label.mb-0(for="related-add-system") Add adjacent system
            select#related-add-system.form-select.form-select-sm.w-auto.mw-100.ps-1.pe-4.text-body.bg-black(name="addSystem" disabled=empty($adjacentSystems))
              if (empty($adjacentSystems))
                option No adjacent systems available
              each $name, $id in ($adjacentSystems ?? [])
                option(value=$id)= $name
            button.btn.btn-sm.btn-success.active.py-2.py-lg-1(type="submit" disabled=empty($adjacentSystems)) Add system
        form.col-12.col-lg-auto.d-flex.flex-wrap.align-items-center.gap-2(method="get" action=$reportUrl data-bs-theme="dark")
          .d-flex.align-items-center.gap-2
            label.form-label.mb-0(for="related-hours-before") Earlier
            select#related-hours-before.form-select.form-select-sm.w-auto.ps-1.pe-4.text-body.bg-black(name="hoursBefore")
              each $hours in range(1, 12)
                option(value=$hours selected=($hours == ($timeOptions['hoursBefore'] ?? 1)))= $hours . ($hours == 1 ? ' hour' : ' hours')
          .d-flex.align-items-center.gap-2
            label.form-label.mb-0(for="related-hours-after") Later
            select#related-hours-after.form-select.form-select-sm.w-auto.ps-1.pe-4.text-body.bg-black(name="hoursAfter")
              each $hours in range(1, 12)
                option(value=$hours selected=($hours == ($timeOptions['hoursAfter'] ?? 2)))= $hours . ($hours == 1 ? ' hour' : ' hours')
          button.btn.btn-sm.btn-success.active.py-2.py-lg-1(type="submit") Update time
        .col-12.col-lg-auto.ms-lg-auto.d-flex.flex-wrap.justify-content-end.align-items-center.gap-2
          a.btn.btn-sm.btn-secondary.py-2.py-lg-1(href=('/related/' . ($solarSystemID ?? 0) . '/' . ($relatedTime ?? 0) . '/')) Reset Report
          a.btn.btn-sm.btn-success.active.py-2.py-lg-1(rel="nofollow" href=('/brsave/?sID=' . ($solarSystemID ?? 0) . '&dttm=' . ($relatedTime ?? 0) . '&options=' . rawurlencode($options ?? '{}'))) Save Battle Report
      if (count((array) ($selectedSystems ?? [])) < 10 && empty($adjacentSystems))
        p.small.text-warning.mb-0 No additional stargate connections were found in the local map data.
    if (!$totalSize && !$totalShips && !$excluded)
      em= 'There was no battle in the selected systems during ' . $reportTime . '.'
    else
      button.btn.btn-outline-secondary.d-lg-none.w-100.mb-2(type="button" data-bs-toggle="collapse" data-bs-target="#relatedComparison" aria-expanded="false" aria-controls="relatedComparison") Compare all sides
      #relatedComparison.collapse.d-lg-block
        .related-quick-compare
          each $metric in [['ISK Lost', 'total_price', $totalLostISK, 2], ['Points Lost', 'total_points', $totalPoints, 0], ['Ships Lost', 'totalShips', $totalShips, 0], ['Efficiency', 'efficiency', 100, 1]]
            .related-quick-metric
              .related-quick-label= $metric[0]
              each $team, $teamKey in $teams
                - $totals = (array) (((array) $team)['totals'] ?? []);
                - $value = $metric[1] == 'efficiency' ? ($totalLostISK > 0 ? (1 - ($totals['total_price'] ?? 0) / $totalLostISK) * 100 : 0) : ($totals[$metric[1]] ?? 0);
                - $pct = $metric[2] > 0 ? $value / $metric[2] * 100 : 0;
                .related-quick-team(class=('related-quick-team-' . strtolower(substr($teamKey, 4))))
                  span.related-quick-team-name= 'Team ' . substr($teamKey, 4)
                  .related-quick-track
                    .related-quick-fill(class=(!in_array($teamKey, ['teamA', 'teamB']) ? 'bg-secondary' : '') style=('width: ' . number_format((float) $pct, 2, '.', '') . '%'))
                  span.related-quick-value= number_format((float) $value, $metric[3]) . ($metric[1] == 'efficiency' ? '%' : '')
        if (count($teams) > 2)
          p.small.text-body-secondary Efficiency compares each side's ISK losses with the combined losses of all other included sides.
      .related-mobile-tabs.d-lg-none.flex-nowrap.overflow-x-auto(role="group" aria-label="Select team")
        each $team, $teamKey in $teams
          button.btn.btn-sm.related-mobile-tab(type="button" class=($teamKey == 'teamA' ? 'is-active' : '') data-team=strtolower(substr($teamKey, 4)) aria-pressed=($teamKey == 'teamA' ? 'true' : 'false'))= 'Team ' . substr($teamKey, 4)
      .row.g-3.flex-lg-nowrap.related-team-grid
        each $team, $teamKey in $teams
          - $team = (array) $team;
          - $totals = (array) ($team['totals'] ?? []);
          - $side = substr($teamKey, 4); $sideClass = strtolower($side);
          .col-12.col-lg.position-relative.overflow-hidden.related-team-panel(class=('related-team-panel-' . $sideClass . ($side == 'A' ? ' is-active' : '')) data-team=$sideClass)
            section.related-team-card.overflow-hidden(class=('related-team-card-' . $sideClass))
              h5.related-team-heading
                = 'Team ' . $side . ' '
                small= '(' . ($totals['pilotCount'] ?? 0) . ' involved)'
              .related-team-entities
                - $entities = $team['entities'] ?? []; $currentSide = $side;
                include components/related_entities.pug
              .related-team-block.related-team-summary.flex-grow-0.flex-shrink-0.overflow-auto
                - $groupIDs = $totals['groupIDs'] ?? [];
                include components/related_summary.pug
              ul.related-team-stats.list-unstyled
                li
                  span Ships Lost
                  strong= number_format((float) ($totals['totalShips'] ?? 0), 0) . ' Ships'
                li
                  span Points Lost
                  strong= number_format((float) ($totals['total_points'] ?? 0), 0)
                li(rel="tooltip" title=$priceTitle($totals['total_price_conv'] ?? []))
                  span ISK Lost
                  strong= number_format((float) ($totals['total_price'] ?? 0), 2)
                li(rel="tooltip" title=$priceTitle($totals['total_dropped_conv'] ?? []))
                  span Loot Dropped
                  strong= number_format((float) ($totals['total_dropped'] ?? 0), 2)
                li
                  span Efficiency
                  strong= number_format($totalLostISK > 0 ? (1 - ($totals['total_price'] ?? 0) / $totalLostISK) * 100 : 0, 1) . ' %'
              .related-team-block.flex-grow-0.flex-shrink-0.mb-0.overflow-auto
                - $list = $team['list'] ?? [];
                include components/related_list.pug
      script(type="text/javascript").
        document.addEventListener("DOMContentLoaded", function () {
          if (typeof window.zkbPageCleanup === "function") window.zkbPageCleanup();
          var tabs = document.querySelectorAll(".related-mobile-tab");
          var panels = document.querySelectorAll(".related-team-panel");
          if (!tabs.length || !panels.length) return;
          var resizeTimer = null;
          function alignTeamRows() {
            [".related-team-heading", ".related-team-entities", ".related-team-summary", ".related-team-stats"].forEach(function (selector) {
              var rows = document.querySelectorAll(".related-team-grid .related-team-card > " + selector);
              rows.forEach(function (row) { row.style.minHeight = ""; });
              if (window.innerWidth < 992) return;
              var maxHeight = 0;
              rows.forEach(function (row) { maxHeight = Math.max(maxHeight, row.getBoundingClientRect().height); });
              rows.forEach(function (row) { row.style.minHeight = Math.ceil(maxHeight) + "px"; });
            });
          }
          function teamFromHash() {
            var team = window.location.hash.replace(/^#team-/, "");
            return Array.from(tabs).some(function (tab) { return tab.dataset.team === team; }) ? team : null;
          }
          function setTeam(team, updateHash) {
            tabs.forEach(function (tab) {
              var active = tab.dataset.team === team;
              tab.classList.toggle("is-active", active);
              tab.setAttribute("aria-pressed", active ? "true" : "false");
            });
            panels.forEach(function (panel) { panel.classList.toggle("is-active", panel.dataset.team === team); });
            if (updateHash) {
              var nextHash = "#team-" + team;
              if (window.history && window.history.replaceState) {
                var historyState = (typeof getSpaHistoryState === "function") ? getSpaHistoryState() : window.history.state;
                window.history.replaceState(historyState, "", nextHash);
              } else {
                window.location.hash = nextHash;
              }
            }
          }
          tabs.forEach(function (tab) { tab.addEventListener("click", function () { setTeam(tab.dataset.team || "a", true); }); });
          setTeam(teamFromHash() || "a", false);
          alignTeamRows();
          function resizeHandler() {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(alignTeamRows, 100);
          }
          function hashChangeHandler() {
            var team = teamFromHash();
            if (team) setTeam(team, false);
          }
          window.addEventListener("resize", resizeHandler);
          $(document).off("zkb:spa:hashchange.relatedTeam").on("zkb:spa:hashchange.relatedTeam", hashChangeHandler);
          window.zkbPageCleanup = function () {
            clearTimeout(resizeTimer);
            window.removeEventListener("resize", resizeHandler);
            $(document).off("zkb:spa:hashchange.relatedTeam", hashChangeHandler);
          };
        });
      .row.g-3.flex-lg-nowrap
        each $team, $teamKey in $teams
          .col-12.col-lg.position-relative.overflow-hidden.related-team-panel(class=($teamKey == 'teamA' ? 'is-active' : '') data-team=strtolower(substr($teamKey, 4)))
            - $killListTitle = 'Team ' . substr($teamKey, 4) . ' Losses';
            - $killList = ((array) $team)['kills'] ?? [];
            - $isEmbedded = true;
            if (count($killList) > 0)
              .related-kill-list
                include components/war_kill_list.pug
    if ($excluded)
      section.related-team-card.d-inline-flex.w-auto.mw-100.h-auto.mt-3.mb-3
        h5.related-team-heading Excluded entities
        p.small Excluded from totals. Choose a side to restore.
        - $entities = $excluded; $currentSide = 'excluded';
        include components/related_entities.pug

block opengraph
  - $ogDescription = 'A battle took place in ' . ($systemName ?? '') . ' (' . ($regionName ?? '') . ') involving ' . $totalSize . ' pilots who lost a total of ' . number_format((float) $totalLostISK, 2, '.', ',') . ' isk';
  meta(name="twitter:title" content=('zKillboard.com / ' . $pageTitle))
  meta(name="twitter:image" content=(($fullsiteurl ?? '') . '/img/3D.png'))
  meta(name="twitter:card" content="summary")
  meta(name="og:title" content=('zKillboard.com / ' . $pageTitle))
  meta(name="twitter:description" content=$ogDescription)
  meta(name="og:description" content=$ogDescription)
  meta(name="og:image" content=(($fullsiteurl ?? '') . '/img/3D.png'))
