extends base.pug

block vars
  - $pageTitle = 'Trophy Leaderboard';
  - $description = 'The zKillboard trophy leaderboard highlights EVE Online characters with the most completed trophy levels.';

block title
  include components/title.pug

block content
  h4 Trophy Leaderboard
  ul.nav.nav-tabs(role="tablist" aria-label="Trophy leaderboard views")
    li.nav-item(role="presentation")
      button#top-trophy-hunters-tab.nav-link.active(type="button" role="tab" data-bs-toggle="tab" data-bs-target="#top-trophy-hunters" aria-controls="top-trophy-hunters" aria-selected="true") Top 100
    li.nav-item(role="presentation")
      button#individual-trophy-leaders-tab.nav-link(type="button" role="tab" data-bs-toggle="tab" data-bs-target="#trophy-leaders-panel" aria-controls="trophy-leaders-panel" aria-selected="false") Trophy Leaders

  .tab-content.pt-3
    #top-trophy-hunters.tab-pane.show.active(role="tabpanel" aria-labelledby="top-trophy-hunters-tab" tabindex="0")
      p Characters with the most trophy levels completed.
      if (count($leaders ?? []) > 0)
        table.table.table-sm.table-striped.table-hover.table-bordered(style="table-layout: fixed; width: 100%;")
          colgroup
            col(style="width: 3.5rem;")
            col
            col(style="width: 5.5rem;")
            col(style="width: 5.5rem;")
            col(style="width: 4.5rem;")
          thead
            tr
              th.text-center(scope="col") Rank
              th(scope="col") Character
              th.text-end(scope="col") Levels
              th.text-end(scope="col") Complete
              th.text-center(scope="col") Trophy
          tbody
            each $field, $index in ($leaders ?? [])
              - $rank = $index + 1;
              - $characterName = $field['characterName'] ?? ('character ' . ($field['characterID'] ?? 0));
              tr
                td.text-center.align-middle= $rank
                th.fw-normal.align-middle(scope="row")
                  .d-flex.align-items-center.gap-1
                    - $imageSize = 32;
                    include components/image_char.pug
                    a.flex-grow-1.text-truncate(style="min-width: 0;" href=('/character/' . ($field['characterID'] ?? 0) . '/trophies/') title=$characterName)= $characterName
                td.text-end.align-middle
                  = number_format((float) ($field['levelCount'] ?? 0), 0)
                  |  /
                  = number_format((float) ($field['maxLevelCount'] ?? 0), 0)
                td.text-end.align-middle
                  = number_format((float) ($field['completedPct'] ?? 0), 0)
                  | %
                td.text-center.align-middle
                  a(href=('/character/' . ($field['characterID'] ?? 0) . '/trophies/') aria-label=('View trophies for ' . $characterName . ', summary level ' . ($field['boxes'] ?? 0)))
                    img.img-fluid(src=('/img/level/level' . ($field['boxes'] ?? 0) . '.gif') alt="")
      else
        h6 No trophy leaders yet.
        p Trophy data is populated by the trophy update job after characters become eligible for trophy calculation.

    #trophy-leaders-panel.tab-pane(role="tabpanel" aria-labelledby="individual-trophy-leaders-tab" tabindex="0")
      p The character with the highest value for each trophy.
      if (count($trophyLeaders ?? []) > 0)
        .row.g-3
          each $trophies, $category in ($trophyLeaders ?? [])
            fieldset.col-12.col-lg-6
              legend= $category
              table.table.table-sm.table-striped(style="table-layout: fixed; width: 100%;")
                colgroup
                  col(style="width: 42%;")
                  col(style="width: 30%;")
                  col(style="width: 16%;")
                  col(style="width: 12%;")
                thead
                  tr
                    th(scope="col") Trophy
                    th(scope="col") Character
                    th.text-end(scope="col") Value
                    th(scope="col")
                tbody
                  each $field, $name in $trophies
                    - $characterName = $field['characterName'] ?? ('character ' . ($field['characterID'] ?? 0));
                    tr
                      th.fw-normal.align-middle(scope="row")= $name
                      td.align-middle
                        a.d-block.text-truncate(href=('/character/' . ($field['characterID'] ?? 0) . '/trophies/') title=$characterName)= $characterName
                      td.text-end.align-middle
                        = number_format((float) ($field['value'] ?? 0), 0)
                        if (isset($field['total']))
                          |  /
                          = number_format((float) $field['total'], 0)
                      td.text-end.align-middle
                        a(href=('/character/' . ($field['characterID'] ?? 0) . '/trophies/') aria-label=('View trophies for ' . $characterName . ', level ' . ($field['level'] ?? 0)))
                          img.img-fluid(src=('/img/level/level' . ($field['level'] ?? 0) . '.gif') alt="")
      else
        p Individual trophy leaders will be populated by the trophy leaderboard job.

  section.mt-4(aria-labelledby="trophy-leader-rules-title")
    h5#trophy-leader-rules-title How Trophy Leaders Are Chosen
    ul.mb-0
      li The character with the highest value for a specific trophy leads that trophy.
      li If values tie, the character with more total trophy levels wins.
      li If total trophy levels also tie, the older character wins.
      li If both characters are still tied, the lower character ID wins to keep the result stable.

block script
  script(type="text/javascript").
    document.addEventListener("DOMContentLoaded", function () {
      var topTab = document.getElementById("top-trophy-hunters-tab");
      var leadersTab = document.getElementById("individual-trophy-leaders-tab");
      if (!topTab || !leadersTab || typeof bootstrap === "undefined") return;

      function showTabFromHash() {
        bootstrap.Tab.getOrCreateInstance(window.location.hash === "#leaders" ? leadersTab : topTab).show();
      }

      [topTab, leadersTab].forEach(function (tab) {
        tab.addEventListener("shown.bs.tab", function () {
          var url = tab === leadersTab ? "#leaders" : window.location.pathname + window.location.search;
          window.history.replaceState(window.history.state, "", url);
        });
      });
      window.addEventListener("hashchange", showTabFromHash);
      showTabFromHash();
    });
