extends base.pug

block vars
  - $pageTitle = 'Sovereignty';
  - $description = 'EVE Online alliances ranked by the number of solar systems where they hold sovereignty.';

block title
  include components/title.pug

block content
  .mb-2
    h1.mb-1
      | Sovereignty
      if (!empty($sovereigntyAvailable))
        small.text-body-secondary.fw-normal.ps-3
          span(format="format-int-once" raw=($totalSystems ?? 0))= $totalSystems ?? 0
          = ' systems '
          span(format="format-int-once" raw=($totalAlliances ?? 0))= $totalAlliances ?? 0
          = ' alliances'
    p.text-body-secondary Alliances ranked by the number of systems they currently hold.
  if (!empty($sovereigntyUpdatedAt))
    p.text-body-secondary
      | Last Updated:
      time(datetime=gmdate('c', $sovereigntyUpdatedAt))= ' ' . gmdate('Y-m-d H:i', $sovereigntyUpdatedAt) . ' UTC'
      | .
  if (empty($sovereigntyAvailable))
    .alert.alert-warning Sovereignty data is temporarily unavailable.
  else
    .table-responsive
      table.table.table-striped.table-hover.align-middle.datatable(data-order='[[2, "desc"]]' data-page-length="-1" data-length-menu='[[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]]')
        thead
          tr
            th.text-center(scope="col") Rank
            th(scope="col") Alliance
            th.text-end(scope="col") Systems
        tbody
          each $alliance, $index in ($alliances ?? [])
            tr
              td.text-center.noclipboard(data-order=($index + 1) data-value=($index + 1) format="format-int-once" raw=($index + 1))= $index + 1
              td
                a.d-inline-flex.align-items-center.gap-2(href=('/alliance/' . $alliance['allianceID'] . '/sov/'))
                  img.rounded(src=('https://images.evetech.net/alliances/' . $alliance['allianceID'] . '/logo?size=32') width="32" height="32" alt=($alliance['allianceName'] . ' logo') loading="lazy" decoding="async")
                  span
                    = $alliance['allianceName']
                    if (!empty($alliance['ticker']))
                      span.text-body-secondary= ' <' . $alliance['ticker'] . '>'
              td.text-end(data-order=$alliance['systems'] data-value=$alliance['systems'])
                a.noclipboard(href=('/alliance/' . $alliance['allianceID'] . '/sov/') format="format-int-once" raw=$alliance['systems'])= $alliance['systems']
