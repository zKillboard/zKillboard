div
  if (!empty($extra['trophies']))
    - $trophies = is_object($extra['trophies']) ? (array) $extra['trophies'] : $extra['trophies'];
    - $levelCount = (int) ($trophies['levelCount'] ?? 0);
    - $maxLevelCount = (int) ($trophies['maxLevelCount'] ?? 0);
    - $boxes = max(0, min(5, (int) ($trophies['boxes'] ?? 0)));
    - $nextBoxLevel = $boxes < 5 && $maxLevelCount > 0 ? (int) ceil($maxLevelCount * ($boxes + 1) / 5) : null;
    - $overallTrophyTitle = 'At: ' . $levelCount . ($nextBoxLevel !== null ? (' Next Level: ' . $nextBoxLevel) : '');
    .row.g-3
      fieldset.col-12.col-lg-4
        legend Trophies
        table.table.table-sm
          tr
            th Level / Total
            th Completed
            th
          tr
            td= $levelCount . ' / ' . $maxLevelCount
            td= ($trophies['completedPct'] ?? 0) . '%'
            td
              img(src=('https://zkillboard.com/img/level/level' . $boxes . '.gif') title=$overallTrophyTitle alt=('Trophy completion level ' . $boxes))
    .row.g-3
      each $conditions, $category in ($trophies['trophies'] ?? [])
        - $conditions = is_object($conditions) ? (array) $conditions : $conditions;
        fieldset.col-12.col-lg-6
          legend= $category
          table.table.table-sm.table-striped
            tr
              th Trophy
              th(style="width: 175px;") &nbsp;
              th
                span.float-end
            each $value, $condition in $conditions
              - $value = is_object($value) ? (array) $value : $value;
              tr
                td(style="width: 100%;")
                  span(class=((($value['met'] ?? 0) > 0) ? 'green' : ''))= $condition
                  if (!empty($value['link']))
                    |  
                    a(href=$value['link'])
                      span.fas.fa-arrow-right.small
                td
                  span.float-end
                    = number_format((float) ($value['value'] ?? 0), 0)
                    if (!empty($value['total']))
                      | &nbsp;/&nbsp;
                      = number_format((float) $value['total'], 0)
                    else if (($value['level'] ?? 0) < 5)
                      | &nbsp;/&nbsp;
                      = number_format((float) ($value['next'] ?? 0), 0)
                td(style="width: 0.5em;")
                  span.float-end
                    img(src=('/img/level/level' . ($value['level'] ?? 0) . '.gif') title=(!empty($value['total']) ? ('At: ' . ($value['value'] ?? 0) . ' / ' . $value['total']) : ('At: ' . ($value['value'] ?? 0) . ((($value['level'] ?? 0) < 5) ? (' Next Level: ' . ($value['next'] ?? 0)) : ''))) alt=('Trophy level ' . ($value['level'] ?? 0)))
    - $trophyCalculation = is_object($extra['trophyCalculation'] ?? null) ? (array) $extra['trophyCalculation'] : ($extra['trophyCalculation'] ?? []);
    - $trophyUpdated = (int) ($trophyCalculation['updated'] ?? 0);
    p.small.text-body-secondary.mt-2.mb-0
      strong Last calculated:
      if ($trophyUpdated > 0)
        time(datetime=gmdate('c', $trophyUpdated))= ' ' . gmdate('Y-m-d H:i', $trophyUpdated) . ' UTC'
      else
        |  Never
      |  &middot;&nbsp;
      strong Pending calculation:
      = !empty($trophyCalculation['pending']) ? ' Yes' : ' No'
    section.mt-4(aria-labelledby="trophy-faq-title")
      h4#trophy-faq-title Trophy FAQ
      dl
        dt How do trophy levels work?
        dd.mb-3 Each trophy has five levels. The number before the slash is the character's current value; the number after it is the next level's target. A fully filled level image means that trophy has reached level five.
        dt What are the Killed trophy thresholds?
        dd.mb-3 Ship-group Killed trophies reach levels one through five at 1, 5, 25, 125, and 625 kills.
        dt What are the Lost trophy thresholds?
        dd.mb-3 Ship-group Lost trophies reach levels one through five at 1, 2, 4, 8, and 16 losses.
        dt What do Level / Total and Completed mean?
        dd.mb-3 Level / Total is the character's aggregate trophy completion score compared with the maximum currently available. Completed is that score shown as a percentage, and the image beside it is a five-step summary of the percentage. Totals can change when trophies or published ship groups change.
        dt When are trophies updated?
        dd.mb-3 Characters with at least 100 recorded kills qualify for pre-calculation. Eligible trophy records are refreshed by a background job no more than once every 24 hours after their statistics are updated. Trophy pages and portrait images use only these pre-calculated records.
        dt What do the green names and arrows mean?
        dd Green means the character has met that trophy's basic requirement. Select an arrow to open the related filtered kill or loss records.
