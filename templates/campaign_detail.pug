extends base.pug

block vars
  - $pageTitle = $pageTitle ?? 'Campaign';

block title
  include components/title.pug

block content
  - $campaignData = is_object($campaign ?? null) ? (array) $campaign : ($campaign ?? []);
  - $filters = is_object($campaignData['filters'] ?? null) ? (array) $campaignData['filters'] : ($campaignData['filters'] ?? []);
  - $startText = (string) ($filters['dtstart'] ?? '');
  - $endText = (string) ($filters['dtend'] ?? '');
  - $filterBadges = Campaign::filterBadges($campaignData);
  - $now = time();
  - $startTime = $startText != '' ? strtotime($startText) : 0;
  - $endTime = $endText != '' ? strtotime($endText) : 0;
  section.related-report-page.war-report-page.campaign-report-page
    h1.visually-hidden= $pageTitle
    h2.related-report-title.war-matchup-title
      span.war-matchup-entity.war-matchup-aggressor.campaign-matchup-entity.campaign-matchup-attacker
        span.campaign-matchup-role Attacker
        if (empty($attackerEntities ?? []))
          span.d-block Attackers
        else
          each $entity in ($attackerEntities ?? [])
            - $entity = is_object($entity) ? (array) $entity : $entity;
            if (($entity['url'] ?? '') != '')
              a.campaign-matchup-link.campaign-matchup-row-left(href=($entity['url'] ?? '#'))
                span.campaign-matchup-name= $entity['name'] ?? ''
                img.campaign-matchup-image(src=($entity['image'] ?? '/img/empty_32.png') alt="" width="32" height="32" loading="lazy" decoding="async" fetchpriority="low" onerror=($entity['imageOnError'] ?? ''))
            else
              span.campaign-matchup-row.campaign-matchup-row-left
                span.campaign-matchup-name= $entity['name'] ?? ''
                img.campaign-matchup-image(src=($entity['image'] ?? '/img/empty_32.png') alt="" width="32" height="32" loading="lazy" decoding="async" fetchpriority="low" onerror=($entity['imageOnError'] ?? ''))
      span.war-matchup-center
        span.war-matchup-versus v
        a.war-matchup-swap(href=($campaignSwapUrl ?? '#') title="Swap sides" aria-label="Swap campaign sides")
          i.fas.fa-retweet(aria-hidden="true")
      span.war-matchup-entity.war-matchup-defender.campaign-matchup-entity.campaign-matchup-defender
        span.campaign-matchup-role Defender
        if (empty($victimEntities ?? []))
          span.d-block Defenders
        else
          each $entity in ($victimEntities ?? [])
            - $entity = is_object($entity) ? (array) $entity : $entity;
            if (($entity['url'] ?? '') != '')
              a.campaign-matchup-link.campaign-matchup-row-right(href=($entity['url'] ?? '#'))
                img.campaign-matchup-image(src=($entity['image'] ?? '/img/empty_32.png') alt="" width="32" height="32" loading="lazy" decoding="async" fetchpriority="low" onerror=($entity['imageOnError'] ?? ''))
                span.campaign-matchup-name= $entity['name'] ?? ''
            else
              span.campaign-matchup-row.campaign-matchup-row-right
                img.campaign-matchup-image(src=($entity['image'] ?? '/img/empty_32.png') alt="" width="32" height="32" loading="lazy" decoding="async" fetchpriority="low" onerror=($entity['imageOnError'] ?? ''))
                span.campaign-matchup-name= $entity['name'] ?? ''
    .d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.mb-3
      dl.war-report-meta.flex-grow-1(style="margin-bottom: 0;")
        div
          dt Visibility
          dd
            if (($campaignData['public'] ?? true) === true)
              span.badge.bg-success Public
            else
              span.badge.bg-secondary Private
        if (($ownerName ?? '') != '')
          div
            dt Owner
            dd
              if (($ownerID ?? 0) > 0)
                a(href=('/character/' . ($ownerID ?? 0) . '/'))= $ownerName
              else
                = $ownerName
        if ($startText != '')
          div
            dt= $startTime > $now ? 'Starting' : 'Started'
            dd= str_replace('T', ' ', $startText)
        if ($endText != '')
          div
            dt= $endTime > $now ? 'Ending' : 'Ended'
            dd= str_replace('T', ' ', $endText)
        if (!empty($filterBadges))
          div
            dt Filters
            dd.d-flex.flex-wrap.gap-1
              each $badge in $filterBadges
                - $badge = is_object($badge) ? (array) $badge : $badge;
                if (($badge['url'] ?? '') != '')
                  a.badge.bg-secondary.text-decoration-none(href=($badge['url'] ?? '#'))= $badge['text'] ?? ''
                else
                  span.badge.bg-secondary= $badge['text'] ?? ''
      .related-report-actions(style="margin: 0;")
        a.btn.btn-sm.btn-info(href=($campaignSearchUrl ?? '/asearch/'))
          i.fas.fa-search(aria-hidden="true")
          |  Advanced Search
        a.btn.btn-sm.btn-secondary(href=($campaignUrl ?? '#') data-zkb-copy-link="1" title="Copy campaign link" aria-label="Copy campaign link")
          i.fas.fa-copy(aria-hidden="true")
          |  Campaign Link
    .text-muted.small.mb-3
      i.fas.fa-info-circle.me-1(aria-hidden="true")
      | Campaigns are experimental and currently in beta. Expect more tweaks and fixes as they settle in.
    if (($campaignData['public'] ?? true) !== true)
      .text-muted.small.text-end.mb-3
        | This is a private campaign, however anyone with the link can view it for sharing purposes.
        i.fas.fa-info-circle.ms-1(aria-hidden="true")
    .daily-async(data-base=($campaignAsyncBase ?? '') data-hash-applied="1")
      .daily-async-part(data-part="stats")
        .text-muted.small.text-center.py-3 Loading campaign stats...
      .war-kill-layout
        aside.war-top-rail.war-top-rail-left
          h3.kill-list-title.campaign-side-rail-title Kills
          each $groupTitle, $groupType in Campaign::topGroups()
            .daily-async-part(data-part="attackers" data-group=$groupType)
              .text-muted.small.text-center.py-3= 'Loading Attacker ' . $groupTitle . '...'
        .war-kill-center
          .daily-async-part(data-part="kills")
            .text-muted.small.text-center.py-3 Loading campaign killmails...
        aside.war-top-rail.war-top-rail-right
          h3.kill-list-title.campaign-side-rail-title Losses
          each $groupTitle, $groupType in Campaign::topGroups()
            .daily-async-part(data-part="victims" data-group=$groupType)
              .text-muted.small.text-center.py-3= 'Loading Defender ' . $groupTitle . '...'
