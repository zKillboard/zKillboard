extends base.pug

block vars
  - $detailData = is_object($detail ?? null) ? (array) $detail : ($detail ?? []);
  - $extraData = is_object($extra ?? null) ? (array) $extra : ($extra ?? []);
  - $pageType = $pageType ?? 'overview';
  - $pageTitle = (!empty($pageType) && $pageType != 'overview') ? (($pageName ?? '') . ' | ' . ucfirst((string) $pageType) . ' | ' . ucfirst((string) ($key ?? ''))) : (($pageName ?? '') . ' | ' . ucfirst((string) ($key ?? '')));
  - $rankText = !empty($detailData['ranks']['overallRank']) ? (': Ranked #' . number_format((float) $detailData['ranks']['overallRank'], 0) . ' with ') : ': ';
  - $description = ($pageName ?? '') . $rankText . number_format((float) ($detailData['shipsDestroyed'] ?? 0), 0) . ' ships destroyed and ' . number_format((float) ($detailData['shipsLost'] ?? 0), 0) . ' ships lost.';
  - $canonical = ($fullsiteurl ?? '') . '/' . ($key ?? '') . '/' . ($id ?? '') . '/';
  - $pageMeta = ['card' => 'summary'];
  if (($key ?? '') == 'character')
    - $pageMeta['image'] = ($image_server ?? 'https://images.evetech.net/') . 'characters/' . ($id ?? '') . '/portrait?size=512';
    - $pageMeta['imageWidth'] = 512;
    - $pageMeta['imageHeight'] = 512;
    - $pageMeta['imageAlt'] = ($pageName ?? '') . ' character portrait';
  else if (in_array(($key ?? ''), ['corporation', 'alliance']))
    - $pageMeta['image'] = ($image_server ?? 'https://images.evetech.net/') . ($key ?? '') . 's/' . ($id ?? '') . '/logo?size=512';
    - $pageMeta['imageWidth'] = 512;
    - $pageMeta['imageHeight'] = 512;
    - $pageMeta['imageAlt'] = ($pageName ?? '') . ' ' . ($key ?? '') . ' logo';
  else if (($key ?? '') == 'system')
    - $pageMeta['image'] = ($fullsiteurl ?? '') . '/img/nohus/systems/' . ($id ?? '') . '.png';
    - $pageMeta['imageWidth'] = 128;
    - $pageMeta['imageHeight'] = 128;
    - $pageMeta['imageType'] = 'image/png';
    - $pageMeta['imageAlt'] = ($pageName ?? '') . ' solar system map';
  else if (($key ?? '') == 'ship')
    - $pageMeta['image'] = ($image_server ?? 'https://images.evetech.net/') . 'types/' . ($id ?? '') . '/render?size=512';
    - $pageMeta['imageWidth'] = 512;
    - $pageMeta['imageHeight'] = 512;
    - $pageMeta['imageAlt'] = ($pageName ?? '') . ' ship render';
  else if (in_array(($key ?? ''), ['region', 'constellation']))
    - $pageMeta['image'] = ($fullsiteurl ?? '') . '/img/nohus/' . ($key ?? '') . 's/' . ($id ?? '') . '.png';
    - $pageMeta['imageWidth'] = 128;
    - $pageMeta['imageHeight'] = 128;
    - $pageMeta['imageType'] = 'image/png';
    - $pageMeta['imageAlt'] = ($pageName ?? '') . ' ' . ($key ?? '') . ' map';
  else
    - $pageMeta['image'] = ($image_server ?? 'https://images.evetech.net/') . ($key ?? '') . 's/' . ($id ?? '') . '/render?size=128';
    - $pageMeta['imageWidth'] = 128;
    - $pageMeta['imageHeight'] = 128;
    - $pageMeta['imageAlt'] = ($pageName ?? '') . ' ' . ($key ?? '') . ' image';

block title
  include components/title.pug

block content
