        li.nav-item
          a.nav-link(class=$isActive('ranks', $pageType) href=('/' . ($key ?? '') . '/' . ($id ?? '') . '/ranks/')) Ranks
        li.nav-item
          a.nav-link(class=$isActive('stats', $pageType) href=('/' . ($key ?? '') . '/' . ($id ?? '') . '/stats/')) Stats
        if (!empty($extraData['hasSupers']))
          li.nav-item
            a.nav-link(class=$isActive('supers', $pageType) href=('/' . ($key ?? '') . '/' . ($id ?? '') . '/supers/')) Supers
        if (in_array(($key ?? ''), ['corporation', 'alliance']))
          li.nav-item
            a.nav-link(class=$isActive('wars', $pageType) href=('/' . ($key ?? '') . '/' . ($id ?? '') . '/wars/')) Wars
        if (($key ?? '') == 'alliance')
          li.nav-item
            a.nav-link(class=$isActive('corpstats', $pageType) href=('/' . ($key ?? '') . '/' . ($id ?? '') . '/corpstats/'))
              svg.me-1.align-text-bottom(width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false")
                path(d="M6 3.5A1.5 1.5 0 0 1 7.5 2h1A1.5 1.5 0 0 1 10 3.5v1A1.5 1.5 0 0 1 8.5 6v1H14a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-1 0V8h-5v.5a.5.5 0 0 1-1 0V8h-5v.5a.5.5 0 0 1-1 0v-1A.5.5 0 0 1 2 7h5.5V6A1.5 1.5 0 0 1 6 4.5zM8.5 5a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5zM0 11.5A1.5 1.5 0 0 1 1.5 10h1A1.5 1.5 0 0 1 4 11.5v1A1.5 1.5 0 0 1 2.5 14h-1A1.5 1.5 0 0 1 0 12.5zm1.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5zm4.5.5A1.5 1.5 0 0 1 7.5 10h1a1.5 1.5 0 0 1 1.5 1.5v1A1.5 1.5 0 0 1 8.5 14h-1A1.5 1.5 0 0 1 6 12.5zm1.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5zm4.5.5a1.5 1.5 0 0 1 1.5-1.5h1a1.5 1.5 0 0 1 1.5 1.5v1a1.5 1.5 0 0 1-1.5 1.5h-1a1.5 1.5 0 0 1-1.5-1.5zm1.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5z")
              | Corps
        if (($key ?? '') == 'alliance' && !empty($hasSovereignty))
          li.nav-item
            a.nav-link(class=$isActive('sov', $pageType) href=('/' . ($key ?? '') . '/' . ($id ?? '') . '/sov/'))
              svg.me-1.align-text-bottom(width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false")
                path(d="M7.657 6.247c.11-.33.576-.33.686 0l.645 1.937a2.89 2.89 0 0 0 1.829 1.828l1.936.645c.33.11.33.576 0 .686l-1.937.645a2.89 2.89 0 0 0-1.828 1.829l-.645 1.936a.361.361 0 0 1-.686 0l-.645-1.937a2.89 2.89 0 0 0-1.828-1.828l-1.937-.645a.361.361 0 0 1 0-.686l1.937-.645a2.89 2.89 0 0 0 1.828-1.828zM3.794 1.148a.217.217 0 0 1 .412 0l.387 1.162c.173.518.579.924 1.097 1.097l1.162.387a.217.217 0 0 1 0 .412l-1.162.387A1.73 1.73 0 0 0 4.593 5.69l-.387 1.162a.217.217 0 0 1-.412 0L3.407 5.69A1.73 1.73 0 0 0 2.31 4.593l-1.162-.387a.217.217 0 0 1 0-.412l1.162-.387A1.73 1.73 0 0 0 3.407 2.31zM10.863.099a.145.145 0 0 1 .274 0l.258.774c.115.346.386.617.732.732l.774.258a.145.145 0 0 1 0 .274l-.774.258a1.16 1.16 0 0 0-.732.732l-.258.774a.145.145 0 0 1-.274 0l-.258-.774a1.16 1.16 0 0 0-.732-.732L9.1 2.137a.145.145 0 0 1 0-.274l.774-.258c.346-.115.617-.386.732-.732z")
              | Sov
      ul.navbar-nav.ms-auto.d-none.d-md-flex
        if (($key ?? '') == 'ship')
          li.nav-item.d-md-none.d-xl-block
            a.nav-link(href=('https://eveconomy.online/item/' . ($id ?? '')) style="background-color:#72ABB6;color:#fff;" target="_blank" rel="noopener noreferrer")
              img(src="/img/eveconomy.png" alt="EVEconomy" style="width:16px;height:16px;vertical-align:middle;margin-right:4px;" loading="lazy" decoding="async" fetchpriority="low")
              | EVEconomy
        if (($key ?? '') == 'character')
          li.nav-item.d-md-none.d-xl-block
            a.nav-link(href="https://podmail.space" style="color:#fff;" target="_blank" rel="noopener noreferrer")
              img(src="/img/podmail.png" alt="PodMail" style="height:16px;vertical-align:middle;margin-right:4px;" loading="lazy" decoding="async" fetchpriority="low")
              | PodMail
        li.nav-item.d-none.d-sm-block
          if (in_array(($key ?? ''), ['character', 'corporation', 'alliance']))
            li.nav-item
              a.nav-link(href="/information/streambox/") StreamBox
          if (($key ?? '') == 'character')
            li.nav-item
              a.nav-link(href=('https://evewho.com/character/' . ($id ?? '')) target="_blank" rel="noopener noreferrer") EVEWho
          else if (($key ?? '') == 'corporation')
            li.nav-item
              a.nav-link(href=('https://evemaps.dotlan.net/corp/' . rawurlencode($pageName ?? '') . '/') target="_blank" rel="noopener noreferrer") DOTLAN
            li.nav-item
              a.nav-link(href=('https://evewho.com/corporation/' . ($id ?? '')) target="_blank" rel="noopener noreferrer") EVEWho
          else if (($key ?? '') == 'alliance')
            li.nav-item
              a.nav-link(href=('https://evemaps.dotlan.net/alliance/' . rawurlencode($pageName ?? '') . '/') target="_blank" rel="noopener noreferrer") DOTLAN
            li.nav-item
              a.nav-link(href=('https://evewho.com/alliance/' . ($id ?? '')) target="_blank" rel="noopener noreferrer") EVEWho
          else if (($key ?? '') == 'system')
            if (($detailData['regionID'] ?? 0) == 10000070)
              li.nav-item
                a.nav-link(href="https://evemetro.com" target="_blank" rel="noopener noreferrer") Eve Metro
            li.nav-item
              a.nav-link(href=('https://evemaps.dotlan.net/system/' . rawurlencode($pageName ?? '') . '/') target="_blank" rel="noopener noreferrer") DOTLAN
          else if (($key ?? '') == 'region')
            if (($id ?? 0) == 10000070)
              li.nav-item
                a.nav-link(href="https://evemetro.com" target="_blank" rel="noopener noreferrer") Eve Metro
            li.nav-item
              a.nav-link(href=('https://evemaps.dotlan.net/region/' . rawurlencode($pageName ?? '') . '/') target="_blank" rel="noopener noreferrer") DOTLAN
          if (!empty($nextID))
